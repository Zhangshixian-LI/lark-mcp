# Required on Railway. Keep real values in Railway Variables, never in this file.
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=replace-in-railway

# Default is China Feishu. Use "lark" for the international Lark platform.
LARK_DOMAIN=feishu

# Optional. Railway supplies PORT and RAILWAY_PUBLIC_DOMAIN automatically.
# PORT=3000
# MCP_ALLOWED_HOSTS=your-custom-domain.example.com
# MCP_BEARER_TOKEN=generate-a-long-random-secret
# LARK_REDIRECT_URI=https://your-domain.example.com/oauth/callback

